@{
    ViewData["Title"] = "Política de Privacidade";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">Política de Privacidade</h2>
        </div>

        <div class="card-body">

            <p class="lead">
                A sua privacidade é importante para nós.
            </p>

            <hr />

            <h4>Coleta de Informações</h4>

            <p>
                Esta aplicação pode coletar informações necessárias para o
                processamento de pedidos, como nome, endereço, telefone
                e e-mail do cliente.
            </p>

            <h4>Utilização dos Dados</h4>

            <p>
                Os dados informados são utilizados exclusivamente para
                identificação do cliente, processamento dos pedidos
                e melhoria da experiência de navegação.
            </p>

            <h4>Compartilhamento</h4>

            <p>
                Nenhuma informação pessoal é compartilhada com terceiros,
                exceto quando exigido por lei.
            </p>

            <h4>Segurança</h4>

            <p>
                Empregamos medidas para proteger as informações armazenadas,
                buscando preservar sua confidencialidade e integridade.
            </p>

            <h4>Contato</h4>

            <p>
                Em caso de dúvidas sobre esta Política de Privacidade,
                utilize a página <strong>Contato</strong> disponível no menu
                principal da aplicação.
            </p>

        </div>

        <div class="card-footer text-center text-muted">
            Última atualização: Agosto de 2026
        </div>

    </div>

</div>