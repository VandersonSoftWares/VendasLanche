@model MVCLanche.Models.Lanche

@{
    ViewData["Title"] = "Excluir Lanche";
}

<h2 class="mb-4 text-danger">
    <i class="bi bi-trash"></i> Excluir Lanche
</h2>

<div class="alert alert-warning shadow-sm">
    <h5>
        <i class="bi bi-exclamation-triangle-fill"></i> Atenção!
    </h5>

    <p class="mb-1">
        Você está prestes a excluir este lanche.
    </p>

    <strong>Esta operação não poderá ser desfeita.</strong>
</div>

<div class="card shadow">

    <div class="card-header bg-danger text-white">
        <i class="bi bi-trash"></i> Confirmação de Exclusão
    </div>

    <div class="card-body">

        <div class="text-center mb-4">

            <img src="@(string.IsNullOrWhiteSpace(Model.ImagemUrl)
                                ? Url.Content("~/images/sem-imagem.png")
                                : Url.Content(Model.ImagemUrl))"
                 class="img-thumbnail"
                 style="max-width:250px;"
                 asp-append-version="true" />

        </div>

        <h3 class="text-center text-primary fw-bold mb-4">
            @Model.Nome
        </h3>

        <div class="row mb-3">

            <div class="col-md-6">
                <strong>Preço</strong><br />
                @Model.Preco.ToString("C")
            </div>

            <div class="col-md-6">
                <strong>Categoria</strong><br />
                @Model.Categoria?.CategoriaNome
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-6">
                <strong>Preferido</strong><br />
                @(Model.IsLanchePreferido ? "Sim" : "Não")
            </div>

            <div class="col-md-6">
                <strong>Em Estoque</strong><br />
                @(Model.EmEstoque ? "Sim" : "Não")
            </div>

        </div>

        <div class="mb-3">
            <strong>Descrição Curta</strong><br />
            @Model.DescricaoCurta
        </div>

        <div class="mb-3">
            <strong>Descrição Detalhada</strong><br />
            @Model.DescricaoDetalhada
        </div>

        <hr />

    </div>

    <div class="card-footer">

        <form asp-action="Delete">

            <input type="hidden" asp-for="LancheId" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash"></i> Excluir definitivamente
                </button>

            </div>

        </form>

    </div>

</div>