@model MVCLanche.ViewModels.LancheFormViewModel

@{
    ViewData["Title"] = "Cadastrar Lanche";
}

<h2 class="mb-4">Cadastrar Lanche</h2>

<form asp-action="Create" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">

        <div class="col-md-8 mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Preco" class="form-label"></label>
            <input asp-for="Preco"
                   type="text"
                   class="form-control" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

    </div>

    <div class="mb-3">
        <label asp-for="DescricaoCurta" class="form-label"></label>
        <textarea asp-for="DescricaoCurta" class="form-control" rows="2"></textarea>
        <span asp-validation-for="DescricaoCurta" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DescricaoDetalhada" class="form-label"></label>
        <textarea asp-for="DescricaoDetalhada" class="form-control" rows="4"></textarea>
        <span asp-validation-for="DescricaoDetalhada" class="text-danger"></span>
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <label asp-for="ImagemArquivo" class="form-label"></label>
            <input asp-for="ImagemArquivo"
                   type="file"
                   class="form-control"
                   accept="image/*" />
            <span asp-validation-for="ImagemArquivo"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3 text-center">
            <img id="previewImagem"
                 src="~/images/sem-imagem.png"
                 class="img-thumbnail"
                 style="max-height:220px;" />
        </div>

    </div>

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId"
                class="form-select"
                asp-items="ViewBag.CategoriaId">
            <option value="">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="form-check">
        <input asp-for="IsLanchePreferido" class="form-check-input" />
        <label asp-for="IsLanchePreferido" class="form-check-label"></label>
    </div>

    <div class="form-check mb-4">
        <input asp-for="EmEstoque" class="form-check-input" />
        <label asp-for="EmEstoque" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-success">
        💾 Salvar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        ↩ Voltar
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("ImagemArquivo")
            .addEventListener("change", function (e) {

                const arquivo = e.target.files[0];

                if (arquivo) {

                    const leitor = new FileReader();

                    leitor.onload = function (evento) {
                        document.getElementById("previewImagem").src =
                            evento.target.result;
                    };

                    leitor.readAsDataURL(arquivo);
                }
            });
    </script>
}