@model MVCLanche.Models.Pedido

@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<h2 class="mb-4">
    <i class="bi bi-receipt"></i> Detalhes do Pedido Nº @Model.PedidoId
</h2>

<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">
        Informações do Cliente
    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-6">
                <strong>Cliente</strong><br />
                @Model.Nome @Model.Sobrenome
            </div>

            <div class="col-md-3">
                <strong>Telefone</strong><br />
                @Model.Telefone
            </div>

            <div class="col-md-3">
                <strong>Data do Pedido</strong><br />
                @Model.PedidoEnviado.ToString("dd/MM/yyyy HH:mm")
            </div>

        </div>

        <div class="mb-3">

            <strong>E-mail</strong><br />
            @Model.Email

        </div>

        <div class="mb-3">

            <strong>Endereço</strong><br />

            @Model.Endereco1

            @if (!string.IsNullOrWhiteSpace(Model.Endereco2))
            {
                <br />
                @Model.Endereco2
            }

            <br />

            @Model.Cidade - @Model.Estado

            <br />

            CEP: @Model.Cep

        </div>

    </div>

</div>

<br />

<div class="card shadow-sm">

    <div class="card-header bg-success text-white">
        Itens do Pedido
    </div>

    <div class="card-body">

        <table class="table table-striped">

            <thead>

                <tr>

                    <th>Lanche</th>

                    <th class="text-center">Quantidade</th>

                    <th class="text-end">Preço Unitário</th>

                    <th class="text-end">Subtotal</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.PedidoItens)
                {
                    <tr>

                        <td>
                            @item.Lanche.Nome
                        </td>

                        <td class="text-center">
                            @item.Quantidade
                        </td>

                        <td class="text-end">
                            @item.Preco.ToString("C")
                        </td>

                        <td class="text-end">
                            @((item.Preco * item.Quantidade).ToString("C"))
                        </td>

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr class="table-light">

                    <th colspan="3" class="text-end">
                        Total do Pedido
                    </th>

                    <th class="text-end">
                        @Model.PedidoTotal.ToString("C")
                    </th>

                </tr>

            </tfoot>

        </table>

    </div>

</div>

<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-secondary">

        ← Voltar para a Lista

    </a>

</div>