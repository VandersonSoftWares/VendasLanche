@model MVCLanche.ViewModels.PedidoPaginacaoViewModel

@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>
        <i class="bi bi-receipt"></i>
        Pedidos
    </h2>

</div>

<table class="table table-striped">

    <thead class="table-dark">

        <tr>

            <th>Nº</th>

            <th>Cliente</th>

            <th>Data</th>

            <th class="text-center">Itens</th>

            <th class="text-end">Total</th>

            <th class="text-center">Ações</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Pedidos)
        {
            <tr>

                <td>
                    @item.PedidoId
                </td>

                <td>
                    @item.Nome @item.Sobrenome
                </td>

                <td>
                    @item.PedidoEnviado.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td class="text-center">
                    @item.TotalItensPedido
                </td>

                <td class="text-end">
                    @item.PedidoTotal.ToString("C")
                </td>

                <td class="text-center">

                    <a asp-action="Details"
                       asp-route-id="@item.PedidoId"
                       class="btn btn-info btn-sm">

                        <i class="bi bi-eye"></i>
                        Detalhes

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>


@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginação dos pedidos">

        <ul class="pagination justify-content-center">

            <!-- Página anterior -->

            <li class="page-item @(Model.TemPaginaAnterior ? "" : "disabled")">

                @if (Model.TemPaginaAnterior)
                {
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@(Model.PaginaAtual - 1)">
                        &laquo; Anterior
                    </a>
                }
                else
                {
                    <span class="page-link">
                        &laquo; Anterior
                    </span>
                }

            </li>


            <!-- Números das páginas -->
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i">
                        @i
                    </a>

                </li>
            }


            <!-- Próxima página -->

            <li class="page-item @(Model.TemProximaPagina ? "" : "disabled")">

                @if (Model.TemProximaPagina)
                {
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@(Model.PaginaAtual + 1)">
                        Próxima &raquo;
                    </a>
                }
                else
                {
                    <span class="page-link">
                        Próxima &raquo;
                    </span>
                }

            </li>

        </ul>

    </nav>
}