@model MVCLanche.Models.Categoria

@{
    ViewData["Title"] = "Nova Categoria";
}

<h2 class="mb-4">
    <i class="bi bi-tags"></i> Nova Categoria
</h2>

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <i class="bi bi-plus-circle"></i> Cadastro de Categoria
    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="CategoriaNome" class="form-label"></label>
                <input asp-for="CategoriaNome" class="form-control" />
                <span asp-validation-for="CategoriaNome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Salvar
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}